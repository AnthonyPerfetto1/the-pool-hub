# Supabase project settings (Project Settings > API in the Supabase dashboard).
# These are safe for client-side use — never put the DATABASE_URL, secret
# key, or service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Express API base URL for local development.
VITE_API_BASE_URL=http://localhost:3000/api/v1
