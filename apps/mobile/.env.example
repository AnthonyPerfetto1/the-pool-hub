# Supabase project settings (Project Settings > API in the Supabase dashboard).
# These are safe for client-side use — never put the DATABASE_URL, secret
# key, or service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Express API base URL. localhost works from the iOS Simulator; a physical
# device needs your machine's LAN IP instead (e.g. http://192.168.1.20:3000/api/v1).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
