PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Used by the server to verify bearer tokens on protected routes. This is the
# same publishable key that's safe to use in the mobile/web clients too.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# PostgreSQL connection string used by Drizzle ORM
# (Project Settings > Database > Connection string in the Supabase dashboard).
# Never commit the real value.
DATABASE_URL=postgres://user:password@host:5432/postgres
